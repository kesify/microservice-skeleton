{
  "name": "kesify/microservice-skeleton",
  "version": "0.1.0",
  "description": "A reusable skeleton package for Laravel microservices.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "talhakeskin",
      "email": "talha@kesify.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^11.39",
    "illuminate/routing": "^11.39",
    "illuminate/config": "^11.39",
    "illuminate/filesystem": "^11.39",
    "illuminate/database": "^11.39",
    "illuminate/auth": "^11.40",
    "spatie/laravel-permission": "^6.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-fileinfo": "*",
    "laravel/passport": "^12.4",
    "illuminate/notifications": "^11.40"
  },
  "autoload": {
    "psr-4": {
      "Kesify\\MicroserviceSkeleton\\": "src/"
    },
    "files": [
      "src/Helpers/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Kesify\\MicroserviceSkeleton\\MicroserviceSkeletonServiceProvider"
      ]
    }
  }
}
